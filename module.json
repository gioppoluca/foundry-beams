{
  "id": "foundry-beams",
  "title": "Active Beams",
  "description": "Adds customizable beam effects to tokens, including wall interactions and reflections.",
  "version": "#{VERSION}#",
  "library": "false",
  "compatibility": {
    "minimum": "12",
    "verified": "13",
    "maximum": "13"
  },
  "authors": [
    {
      "name": "Luca Gioppo",
      "url": "https://github.com/gioppoluca/foundry-beams",
      "discord": "gioppoluca",
      "flags": {}
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "sequencer",
        "type": "module",
        "manifest": "https://github.com/fantasycalendar/FoundryVTT-Sequencer/releases/latest/download/module.json"
      },
      {
        "id": "socketlib",
        "type": "module"
      }
    ]
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/beam.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json",
      "flags": {}
    }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "license": "LICENSE",
  "readme": "README.md",
  "media": [
    {
      "type": "icon",
      "url": "https://avatars2.githubusercontent.com/u/71292812?s=400&u=ccdb4eeb7abf551ca8f314e5a9bfd0479a4d3d41&v=4",
      "loop": false,
      "flags": {}
    }
  ],
  "packs": [
    {
      "name": "beam-macros",
      "label": "Beam Macros",
      "path": "packs/beam-macros",
      "type": "Macro",
      "banner": "modules/foundry-beams/images/macros.webp",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "system": "dnd5e"
    },
    {
      "name": "beam-scenes",
      "label": "Beam Scenes",
      "path": "packs/beam-scenes",
      "type": "Scene",
      "banner": "modules/foundry-beams/images/scenes.webp",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "system": "dnd5e"
    },
    {
      "name": "beam-actors",
      "label": "Beam Actors",
      "path": "packs/beam-actors",
      "type": "Actor",
      "banner": "modules/foundry-beams/images/actors.webp",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "system": "dnd5e"
    }
  ],
  "packFolders": [
    {
      "name": "Active Beams",
      "sorting": "m",
      "color": "#e8962a",
      "packs": [
        "beam-actors",
        "beam-scenes",
        "beam-macros"
      ]
    }
  ]
}